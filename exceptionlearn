İskelet kod
1) Mesaj dosyası — `src/main/resources/messages.properties`
```properties
# Kullanıcıya giden BÜTÜN metinler burada. {0}, {1} = parametre.
error.user.notfound=Kullanıcı bulunamadı: {0}
error.balance.insufficient=Bakiye yetersiz. Gerekli: {0} TL
error.generic.invalid.request=Geçersiz istek
error.generic.conflict=Kaynak çakışması
error.generic.database=Veritabanı hatası oluştu
error.generic.unexpected=Beklenmeyen bir hata oluştu
error.generic.upstream={0} servisi şu anda yanıt vermiyor
```
İkinci dil gerekiyorsa `messages_en.properties` ekle — anahtar listeleri birebir aynı olmalı.
2) Taban exception
```java
@Getter
public class AppException extends RuntimeException {
    private final String messageKey;   // messages.properties anahtarı
    private final String errorCode;    // frontend'in gördüğü sabit kod
    private final Object[] args;       // {0}, {1} için değerler

    public AppException(String messageKey, String errorCode, Object... args) {
        super(messageKey);             // log'da anahtar görünsün
        this.messageKey = messageKey;
        this.errorCode = errorCode;
        this.args = args;
    }

    public AppException(String messageKey, String errorCode, Throwable cause, Object... args) {
        super(messageKey, cause);      // cause KAYBOLMASIN
        this.messageKey = messageKey;
        this.errorCode = errorCode;
        this.args = args;
    }
}
```
3) Domain exception (her iş hatası için bir tane, 5 satır)
```java
public class UserNotFoundException extends AppException {
    public UserNotFoundException(String userId) {
        super("error.user.notfound", "USER_NOT_FOUND", userId);
    }
}
```
4) Cevap zarfı
```java
@Getter @Builder
@JsonInclude(JsonInclude.Include.NON_NULL)
public class ApiResponse<T> {
    private boolean success;
    private String message;
    private T data;
    private int httpStatusCode;
    private String errorCode;

    public static <T> ApiResponse<T> success(T data) {
        return ApiResponse.<T>builder().success(true).data(data).httpStatusCode(200).build();
    }

    public static <T> ApiResponse<T> error(String message, String errorCode, int status) {
        return ApiResponse.<T>builder().success(false).message(message)
                .errorCode(errorCode).httpStatusCode(status).build();
    }
}
```
5) Global handler
```java
@Slf4j
@RestControllerAdvice
@RequiredArgsConstructor
public class GlobalExceptionHandler {

    private final MessageSource messageSource;

    // --- Domain hataları: status'u burada eşleştir ---
    @ExceptionHandler(UserNotFoundException.class)
    public ResponseEntity<ApiResponse<Void>> handleUserNotFound(UserNotFoundException ex) {
        return build(ex, HttpStatus.NOT_FOUND, false);
    }

    @ExceptionHandler(InsufficientBalanceException.class)
    public ResponseEntity<ApiResponse<Void>> handleInsufficientBalance(InsufficientBalanceException ex) {
        return build(ex, HttpStatus.UNPROCESSABLE_ENTITY, false);
    }

    @ExceptionHandler(PaymentServiceException.class)
    public ResponseEntity<ApiResponse<Void>> handlePayment(PaymentServiceException ex) {
        return build(ex, HttpStatus.SERVICE_UNAVAILABLE, true);   // 5xx -> stack trace'li log
    }

    /** Eşlenmemiş her AppException için son durak. */
    @ExceptionHandler(AppException.class)
    public ResponseEntity<ApiResponse<Void>> handleApp(AppException ex) {
        return build(ex, HttpStatus.INTERNAL_SERVER_ERROR, true);
    }

    // --- Bean validation (@Valid) ---
    @ExceptionHandler({MethodArgumentNotValidException.class, BindException.class})
    public ResponseEntity<ApiResponse<Void>> handleValidation(BindException ex) {
        String detail = ex.getBindingResult().getFieldErrors().stream()
                .map(f -> f.getField() + ": " + f.getDefaultMessage())
                .collect(Collectors.joining("; "));
        log.warn("Validation failed: {}", detail);                // 4xx -> warn
        // Alan hataları güvenli: metinler bizim @NotBlank/@Size mesajlarımızdan geliyor.
        return ResponseEntity.badRequest()
                .body(ApiResponse.error(detail, "VALIDATION_FAILED", 400));
    }

    // --- DB çakışması ---
    @ExceptionHandler({DuplicateKeyException.class, DataIntegrityViolationException.class})
    public ResponseEntity<ApiResponse<Void>> handleConflict(Exception ex) {
        log.warn("Data conflict: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.CONFLICT).body(ApiResponse.error(
                msg("error.generic.conflict", "Kaynak çakışması"), "RESOURCE_CONFLICT", 409));
    }

    // --- DB hatası: detay SADECE log'a ---
    @ExceptionHandler({SQLException.class, DataAccessException.class})
    public ResponseEntity<ApiResponse<Void>> handleDatabase(Exception ex) {
        log.error("Database error: {}", ex.getMessage(), ex);
        return ResponseEntity.status(500).body(ApiResponse.error(
                msg("error.generic.database", "Veritabanı hatası oluştu"), "DATABASE_ERROR", 500));
    }

    // --- Son durak: hiçbir hata çıplak kalmasın ---
    @ExceptionHandler(Exception.class)
    public ResponseEntity<ApiResponse<Void>> handleUnexpected(Exception ex) {
        if (isClientAbort(ex)) {                                  // Kural 12
            log.debug("Client disconnected: {}", ex.getMessage());
            return ResponseEntity.noContent().build();
        }
        log.error("Unhandled error: {}", ex.getMessage(), ex);
        return ResponseEntity.status(500).body(ApiResponse.error(
                msg("error.generic.unexpected", "Beklenmeyen bir hata oluştu"), "INTERNAL_ERROR", 500));
    }

    // ---------------- yardımcılar ----------------

    private ResponseEntity<ApiResponse<Void>> build(AppException ex, HttpStatus status, boolean serverFault) {
        if (serverFault) {
            log.error("{} -> {} key={}", ex.getClass().getSimpleName(), status, ex.getMessageKey(), ex);
        } else {
            log.warn("{} -> {} key={} args={}", ex.getClass().getSimpleName(), status,
                    ex.getMessageKey(), ex.getArgs());
        }
        String text = msg(ex.getMessageKey(), status.getReasonPhrase(), ex.getArgs());
        return ResponseEntity.status(status).body(ApiResponse.error(text, ex.getErrorCode(), status.value()));
    }

    /** Mesaj arama ASLA patlamamalı (Kural 11). */
    private String msg(String key, String fallback, Object... args) {
        try {
            return messageSource.getMessage(key, args, LocaleContextHolder.getLocale());
        } catch (Exception e) {
            log.warn("Missing message key: {}", key);
            return fallback;
        }
    }

    private static boolean isClientAbort(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            String m = c.getMessage();
            if (c.getClass().getName().contains("ClientAbortException")
                    || (m != null && (m.contains("Broken pipe") || m.contains("Connection reset")))) {
                return true;
            }
        }
        return false;
    }
}
```
6) Kullanım — service ve controller
```java
// Service: hata fırlat, mesaj kurma
public User get(String id) {
    return repository.findById(id).orElseThrow(() -> new UserNotFoundException(id));
}

// Client katmanı: altyapı hatasını sarmala, cause'u ilet
try {
    return paymentClient.charge(req);
} catch (RestClientException e) {
    throw new PaymentServiceException(e);
}

// Controller: try/catch YOK, sadece mutlu yol
@GetMapping("/{id}")
public ApiResponse<UserResponse> get(@PathVariable String id) {
    return ApiResponse.success(mapper.toResponse(userService.get(id)));
}
```
