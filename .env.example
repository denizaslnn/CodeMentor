# CodeMentor environment variables template.
# Kullanım: bu dosyayi `.env` olarak kopyala, gercek degerleri gir. `.env` asla commit edilmez.
#
# JWT auth. Secret is BASE64 of >= 256-bit (32+ byte) key. Generate with:
#   openssl rand -base64 48
# (never commit a real secret; .env is git-ignored)
JWT_SECRET=replace-with-48-byte-base64-secret
ACCESS_TOKEN_EXPIRATION=900000   # 15 dk
REFRESH_TOKEN_EXPIRATION=604800000 # 7 gun

# Local (http) gelistirme icin false; production (https) icin true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth

# Auth brute-force protection (per-IP, applied by api-gateway on /api/v1/auth/**)
AUTH_RATELIMIT_MAX_ATTEMPTS=10
AUTH_RATELIMIT_WINDOW_SECONDS=60
AUTH_RATELIMIT_REDIS_KEY_PREFIX=auth_rl

CORS_ALLOWED_ORIGINS=http://localhost:3000